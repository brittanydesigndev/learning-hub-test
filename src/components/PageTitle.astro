---
/**
 * Replaces Starlight's page title. For articles that have review details in
 * their front matter, it adds:
 *   - a "Reviewed" / "Review due" badge
 *   - the article type and audience
 *   - an "Article info" button that opens a slide-out panel with the owner,
 *     reviewer, review dates and the change history pulled from Git.
 */
import { getHistory } from '../lib/history';

const { entry } = Astro.locals.starlightRoute;
const data = entry.data;
const isArticle = Boolean(data.last_reviewed || data.owner);

const fmt = (d?: Date) =>
	d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '';

const today = new Date();
const reviewDue = data.next_review ? data.next_review.getTime() < today.getTime() : false;

const history = isArticle && entry.filePath ? getHistory(entry.filePath, 6) : [];

// Links back to GitHub work when the site is built by GitHub Actions.
const repo = process.env.GITHUB_REPOSITORY;
const branch = process.env.GITHUB_REF_NAME || 'main';
const historyUrl = repo && entry.filePath ? `https://github.com/${repo}/commits/${branch}/${entry.filePath}` : null;

const metaBits = [data.type, data.audience?.join(', ')].filter(Boolean).join(' · ');
---

<h1 id="_top" class:list={[data.template === 'splash' && 'sr-only']}>{data.title}</h1>

{
	isArticle && (
		<div class="kb-meta" data-pagefind-ignore="all">
			{data.last_reviewed &&
				(reviewDue ? (
					<span class="kb-badge kb-badge--warn">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
						Review due
					</span>
				) : (
					<span class="kb-badge kb-badge--ok">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
						Reviewed {fmt(data.last_reviewed)}
					</span>
				))}
			{metaBits && <span class="kb-meta-text">{metaBits}</span>}
			<button type="button" class="kb-info-btn" data-kb-open aria-haspopup="dialog">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6" /><path d="M12 7.5v.5" /></svg>
				Article info
			</button>
		</div>

		<dialog class="kb-panel" aria-labelledby="kb-panel-title" data-pagefind-ignore="all">
			<div class="kb-panel-inner">
				<div class="kb-panel-head">
					<h2 id="kb-panel-title">Article info</h2>
					<button type="button" class="kb-close" data-kb-close aria-label="Close article info">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12" /><path d="M18 6L6 18" /></svg>
					</button>
				</div>

				{data.next_review && (
					<div class:list={['kb-status', reviewDue && 'kb-status--warn']}>
						<strong>{reviewDue ? 'Review overdue' : 'Current'}</strong>
						<span>Next review {reviewDue ? 'was due' : 'due'} {fmt(data.next_review)}</span>
					</div>
				)}

				<dl class="kb-facts">
					{data.owner && (
						<>
							<dt>Owner</dt>
							<dd>
								<strong>{data.owner}</strong>
								{data.owner_team && <span>{data.owner_team}</span>}
							</dd>
						</>
					)}
					{data.reviewed_by && (
						<>
							<dt>Reviewed by</dt>
							<dd>
								<strong>{data.reviewed_by}</strong>
								<span>{[data.reviewer_role, fmt(data.last_reviewed)].filter(Boolean).join(' · ')}</span>
							</dd>
						</>
					)}
					{data.audience && (
						<>
							<dt>Audience</dt>
							<dd>{data.audience.join(', ')}</dd>
						</>
					)}
					{data.type && (
						<>
							<dt>Type</dt>
							<dd>{data.type}</dd>
						</>
					)}
					{data.walkthrough_checked && (
						<>
							<dt>Walkthrough</dt>
							<dd>Checked {fmt(data.walkthrough_checked)}</dd>
						</>
					)}
				</dl>

				<section>
					<h3>Change history</h3>
					{history.length > 0 ? (
						<ol class="kb-history">
							{history.map((h, i) => (
								<li class:list={[i === 0 && 'is-latest']}>
									<span class="kb-history-date">{fmt(h.date)}</span>
									<span class="kb-history-msg">{h.message}</span>
									<span class="kb-history-by">by {h.author}</span>
								</li>
							))}
						</ol>
					) : (
						<p class="kb-empty">History appears here once this article is committed to GitHub.</p>
					)}
				</section>

				{historyUrl && (
					<div class="kb-panel-links">
						<a href={historyUrl}>View full history on GitHub</a>
					</div>
				)}
			</div>
		</dialog>
	)
}

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-kb-open]').forEach((btn) => {
		const dialog = btn.parentElement?.nextElementSibling as HTMLDialogElement | null;
		if (!dialog) return;
		btn.addEventListener('click', () => dialog.showModal());
		dialog.querySelector('[data-kb-close]')?.addEventListener('click', () => dialog.close());
		// Clicking the dimmed area outside the panel closes it.
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
	});
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	h1 {
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.kb-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1rem;
		margin-top: 1rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--kb-line);
	}
	.kb-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 1.9rem;
		padding: 0 0.75rem;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
	}
	.kb-badge--ok {
		background: var(--kb-ok-bg);
		color: var(--kb-ok-fg);
	}
	.kb-badge--warn {
		background: var(--kb-warn-bg);
		color: var(--kb-warn-fg);
	}
	.kb-meta-text {
		color: var(--kb-muted);
		font-size: 0.9rem;
	}
	.kb-info-btn {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1rem;
		border-radius: 10px;
		border: 1px solid var(--kb-line);
		background: var(--kb-surface);
		color: var(--sl-color-white);
		font: inherit;
		font-weight: 600;
		font-size: 0.95rem;
		cursor: pointer;
	}
	.kb-info-btn:hover {
		border-color: var(--sl-color-accent);
	}

	/* Slide-out panel */
	.kb-panel {
		margin: 0 0 0 auto;
		height: 100dvh;
		max-height: 100dvh;
		width: min(420px, 100vw);
		padding: 0;
		border: 0;
		border-left: 1px solid var(--kb-line);
		background: var(--kb-surface);
		color: var(--sl-color-white);
		box-shadow: -12px 0 32px rgb(0 0 0 / 0.15);
	}
	.kb-panel[open] {
		animation: kb-slide 0.22s ease-out;
	}
	.kb-panel::backdrop {
		background: rgb(23 32 43 / 0.35);
	}
	@keyframes kb-slide {
		from {
			transform: translateX(100%);
		}
		to {
			transform: translateX(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.kb-panel[open] {
			animation: none;
		}
	}
	.kb-panel-inner {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		min-height: 100%;
		box-sizing: border-box;
	}
	.kb-panel-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.kb-panel-head h2 {
		margin: 0;
		font-size: 1.25rem;
		color: var(--sl-color-white);
	}
	.kb-close {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 10px;
		border: 1px solid var(--kb-line);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.kb-status {
		display: flex;
		flex-direction: column;
		padding: 0.85rem 1rem;
		border-radius: 12px;
		background: var(--kb-ok-bg);
		color: var(--kb-ok-fg);
	}
	.kb-status--warn {
		background: var(--kb-warn-bg);
		color: var(--kb-warn-fg);
	}
	.kb-status span {
		font-size: 0.875rem;
	}
	.kb-facts {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.85rem 0.75rem;
		margin: 0;
		font-size: 0.95rem;
	}
	.kb-facts dt {
		color: var(--kb-muted);
	}
	.kb-facts dd {
		margin: 0;
		display: flex;
		flex-direction: column;
	}
	.kb-facts dd span {
		color: var(--kb-muted);
		font-size: 0.875rem;
	}
	.kb-panel h3 {
		margin: 0 0 0.75rem;
		font-size: 0.95rem;
		color: var(--sl-color-white);
	}
	.kb-history {
		list-style: none;
		margin: 0;
		padding: 0 0 0 1.1rem;
		border-left: 2px solid var(--kb-line);
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}
	.kb-history li {
		position: relative;
		display: flex;
		flex-direction: column;
		margin: 0;
	}
	.kb-history li::before {
		content: '';
		position: absolute;
		left: calc(-1.1rem - 7px);
		top: 0.35rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--kb-line);
	}
	.kb-history li.is-latest::before {
		background: var(--kb-accent-solid);
	}
	.kb-history-date {
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		color: var(--kb-muted);
	}
	.kb-history-msg {
		font-size: 0.95rem;
	}
	.kb-history-by,
	.kb-empty {
		font-size: 0.85rem;
		color: var(--kb-muted);
		margin: 0;
	}
	.kb-panel-links {
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--kb-line);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-weight: 600;
	}
</style>
